# Copie estes nomes para Vercel → Project → Settings → Environment Variables e faça um redeploy.
# (Este arquivo é só um modelo. Nunca suba chaves reais para o GitHub.)

# --- Supabase: Project Settings → API ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...        # chave pública (publishable/anon); a tela a recebe por /api/config
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # chave secreta (secret/service_role); usada só por /api/seatalk

# --- Anexos no Google Drive: URL /exec do Apps Script (apps-script/Code.gs). Vazia = anexos no Supabase Storage ---
DRIVE_UPLOAD_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- SeaTalk, caminho A (mais simples): webhook de um "System Account" criado nas configurações de um grupo ---
SEATALK_WEBHOOK_URL=https://openapi.seatalk.io/webhook/group/xxxxxxxxxxxxxxxxxxxxxx

# --- SeaTalk, caminho B: bot criado em https://open.seatalk.io (mensagem direta e grupo da solicitação) ---
SEATALK_APP_ID=
SEATALK_APP_SECRET=
