# Copie estes nomes para Vercel → Project → Settings → Environment Variables e faça um redeploy.
# (Este arquivo é só um modelo. Nunca suba chaves reais para o GitHub.)

# --- Supabase: Project Settings → API ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...        # chave pública (publishable/anon); a tela a recebe por /api/config
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # chave secreta (secret/service_role); usada só por /api/seatalk e /api/cleanup

# --- Limpeza diária de anexos (Vercel Cron): texto aleatório de 16+ caracteres inventado por você ---
CRON_SECRET=

# --- SeaTalk: bot criado em https://open.seatalk.io (mensagem direta ao solicitante) ---
SEATALK_APP_ID=
SEATALK_APP_SECRET=
