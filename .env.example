# Copie estes nomes para Vercel → Project → Settings → Environment Variables.
# (Este arquivo é só um modelo. Nunca suba as chaves reais para o GitHub.)

# --- Supabase: Project Settings → API ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...        # chave pública (publishable/anon), a mesma do index.html
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # chave secreta (secret/service_role) — SÓ na Vercel, nunca no HTML

# --- SeaTalk, caminho A (mais simples): webhook de um "System Account" criado nas configurações de um grupo ---
SEATALK_WEBHOOK_URL=https://openapi.seatalk.io/webhook/group/xxxxxxxxxxxxxxxxxxxxxx

# --- SeaTalk, caminho B: bot criado em https://open.seatalk.io (mensagem direta e grupo da solicitação) ---
SEATALK_APP_ID=
SEATALK_APP_SECRET=
